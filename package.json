{
  "name": "alchemy-proxmox",
  "version": "0.0.0",
  "exports": {
    ".": "./src/index.ts",
    "./Credentials": "./src/Credentials.ts"
  },
  "files": [
    "src",
    "README.md",
    "PROVENANCE.md",
    "LICENSE",
    "LICENSE-homeflare-kit"
  ],
  "description": "Proxmox VE resources for Alchemy",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "vendor:agent-sources": "bash scripts/vendor-agent-sources.sh",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src test package.json tsconfig.json vitest.config.ts README.md PROVENANCE.md pnpm-workspace.yaml",
    "check": "pnpm typecheck && prettier --check src test package.json tsconfig.json vitest.config.ts README.md PROVENANCE.md pnpm-workspace.yaml",
    "test": "ALCHEMY_TELEMETRY_DISABLED=1 vitest run"
  },
  "dependencies": {
    "@distilled.cloud/proxmox": "npm:@homeflare/distilled-proxmox@0.3.5"
  },
  "peerDependencies": {
    "alchemy": "2.0.0-beta.83",
    "effect": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "alchemy": "2.0.0-beta.83",
    "effect": "4.0.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
